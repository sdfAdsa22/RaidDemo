# =============================================================================
# Git 属性配置
# =============================================================================
# 目的：统一跨平台的行尾符与文本处理方式，避免 Windows / macOS / Linux 协作时
# 出现整文件级的换行符 diff 噪声。

# 默认：由 Git 自动判断文本文件，并在检出时统一为 LF
* text=auto

# 源码与文本配置文件统一使用 LF
*.cs      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.asmdef  text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.vsconfig  text eol=lf
*.inputactions text eol=lf
*.uss     text eol=lf
*.wlt     text eol=lf

# Windows 专用脚本保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Unity 场景、预制体、资源文件：文本格式，统一 LF
# （Unity 默认使用 Force Text 序列化，因此这些文件可以正常做 diff）
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.controller text eol=lf
*.anim    text eol=lf
*.meta    text eol=lf

# -----------------------------------------------------------------------------
# 二进制资源：禁止行尾符转换与 diff（未纳入 LFS 的小体积文件）
# -----------------------------------------------------------------------------
*.ttf     binary
*.otf     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.bundle  binary
*.a       binary
*.exe     binary

# -----------------------------------------------------------------------------
# Git LFS：大型二进制资源交由 LFS 存储（M7 批次 0 起启用）
# -----------------------------------------------------------------------------
# 为什么启用：美术资源（模型、贴图、音频）体积远超源代码，直接写进 Git 历史会让
# 仓库迅速膨胀且无法回收。走 LFS 后，仓库只保存指针文件，克隆时按需拉取。
# 使用前置：本地已执行 `git lfs install --local`（钩子写入 .git/hooks，不入库）。
# 注意：新增此类文件时无需手动 `git lfs track`，本段规则已覆盖。

# 3D 模型与工程文件
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.FBX       filter=lfs diff=lfs merge=lfs -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.gltf      filter=lfs diff=lfs merge=lfs -text
*.glb       filter=lfs diff=lfs merge=lfs -text
*.dae       filter=lfs diff=lfs merge=lfs -text
*.stl       filter=lfs diff=lfs merge=lfs -text

# 贴图与图像资源
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.tif       filter=lfs diff=lfs merge=lfs -text
*.tiff      filter=lfs diff=lfs merge=lfs -text
*.exr       filter=lfs diff=lfs merge=lfs -text
*.hdr       filter=lfs diff=lfs merge=lfs -text

# 音频与视频资源
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.aiff      filter=lfs diff=lfs merge=lfs -text
*.flac      filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text
*.webm      filter=lfs diff=lfs merge=lfs -text

# Unity 资源包（导入后即可删除，保留归档以免重复下载）
*.unitypackage filter=lfs diff=lfs merge=lfs -text
